# 数据源本地部署环境变量模板
# 用法：复制为 .env 后填写，或直接 export；生产环境改用密钥管理，禁止提交真实密钥到 git
#
# 生成方式：
#   1. 灰豚：TRAE ht-api Connector 授权后，密钥自动注入为环境变量 Data_Query_KEY（本文件从 env 导出）
#   2. 蝉妈妈：TRAE chanmama Connector 授权后，access token 由 TRAE 管理；
#      本地 MCP 客户端加载 chanmama.mcp.json 时，需将 token 注入环境变量 CHANMAMA_ACCESS_TOKEN

# ---------- 灰豚 ht-api（D1 必装） ----------
# 由用户提供并写入（2026-09-11 更新，勿外泄）
Data_Query_KEY=dy_ak_BcsMaWFPWyM8F47prP5VPi4k9rkzMgJT2mwEF5oupy8
# 服务地址（默认即可）
HT_API_BASE_URL=https://dyapi.huitun.com

# ---------- 蝉妈妈 Remote MCP（D2 必装） ----------
# 本地 MCP 客户端加载 chanmama.mcp.json 时使用；Bearer token 由 OAuth 换取后注入
CHANMAMA_ACCESS_TOKEN=<OAuth access token>

# ---------- 抖店开放平台（D3 可选，S0 自动取数时启用） ----------
# 应用创建后从开放平台后台获取；access_token 每 7 天刷新
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
DOUYIN_ACCESS_TOKEN=
